{
  "name": "personal-dashboard",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "node scripts/prepare-frontend.mjs && tsc",
    "test:frontend": "node --test tests/frontend/*.test.ts",
    "check": "npm run build && cargo check --manifest-path src-tauri/Cargo.toml",
    "prototype:dashboard-2": "node .scratch/personal-dashboard-2/prototype/serve.mjs",
    "prototype:mac-workspace": "node .scratch/personal-dashboard-mac-workspace/prototype/serve.mjs",
    "prototype:codex-collaboration": "node .scratch/personal-dashboard-codex-collaboration/prototype/serve.mjs",
    "build:mac": "tauri build --bundles app",
    "accept:mac": "scripts/acceptance/macos-packaged-launch.sh",
    "accept:cutover": "scripts/acceptance/tauri-only-source.sh && scripts/acceptance/macos-cutover-workflow.sh",
    "tauri": "tauri",
    "prototype:experience": "node .scratch/personal-dashboard-experience/prototype/serve.mjs",
    "build:voice-gate": "node scripts/prepare-frontend.mjs --diagnostic-voice-gate && tsc -p tsconfig.voice-gate.json",
    "build:beta": "node scripts/release/build-beta.mjs"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.4",
    "typescript": "7.0.2"
  }
}
